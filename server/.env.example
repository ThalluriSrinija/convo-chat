# ─────────────────────────────────────────────────────────────
# Convo Server — Environment Variables
# Copy this file to server/.env and fill in the values.
# NEVER commit server/.env to version control.
# ─────────────────────────────────────────────────────────────

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/convo
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/convo
MONGODB_URI=mongodb://127.0.0.1:27017/convo

# Name of the MongoDB database (must match the URI database name)
DB_NAME=convo

# Port for the Express server
PORT=5000

# JWT secret (min 32 chars, random)
JWT_SECRET=replace_this_with_a_long_random_string

# JWT expiry (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# bcrypt salt rounds (10–12 recommended for production)
BCRYPT_ROUNDS=10

# GridFS bucket name for images
GRIDFS_BUCKET_NAME=images

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173
