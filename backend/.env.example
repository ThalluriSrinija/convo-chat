# ─────────────────────────────────────────────────────────────
# Convo Backend — Environment Variables
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Node environment: development | production | test
NODE_ENV=development

# Express server port
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/convo
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/convo
MONGODB_URI=mongodb://127.0.0.1:27017/convo

# MongoDB database name (must match the URI database name)
DB_NAME=convo

# JWT signing secret — minimum 32 random characters
JWT_SECRET=replace_this_with_a_long_random_secret_string

# JWT token lifetime (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# bcrypt salt rounds (10 for dev, 12 for production)
BCRYPT_ROUNDS=10

# GridFS bucket name for image storage
GRIDFS_BUCKET_NAME=images

# Frontend URL — used for CORS allow-list
# Development:  http://localhost:5173
# Production:   https://yourconvodomain.com
FRONTEND_URL=http://localhost:5173
